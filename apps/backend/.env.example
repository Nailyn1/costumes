# Шаблон apps/backend/.env для локальной разработки. Скопируй в .env и заполни.
# Значения ниже — плейсхолдеры, реальные секреты в git не коммитятся.

NODE_ENV=development
PORT=5000

# Postgres (контейнер из docker-compose.dev.yml)
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/costumes?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=costumes

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
SERVER_DOMAIN=localhost

JWT_SECRET=change-me-long-random-string

# WhatsApp (Green-API). Локально можно оставить пустым: отправка упадёт, job уйдёт в ретраи
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# Sentry (необязательно)
SENTRY_DSN=

# Пользователи для `db:seed`: логин >= 6 символов, пароль >= 12
USER1_LOGIN=change-me-login1
USER1_NAME=Имя 1
USER1_PASSWORD=change-me-password-1
USER2_LOGIN=change-me-login2
USER2_NAME=Имя 2
USER2_PASSWORD=change-me-password-2
USER3_LOGIN=change-me-login3
USER3_NAME=Имя 3
USER3_PASSWORD=change-me-password-3
USER4_LOGIN=change-me-login4
USER4_NAME=Имя 4
USER4_PASSWORD=change-me-password-4
USER5_LOGIN=change-me-login5
USER5_NAME=Имя 5
USER5_PASSWORD=change-me-password-5
