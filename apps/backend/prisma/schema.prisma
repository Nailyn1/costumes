// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @default(autoincrement()) @id
  login String @unique
  password String 
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  auditEvents AuditEvent[]
  commandReceipts CommandReceipt[]

  @@map("users")
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String   
  notes     String?

  isBlacklisted   Boolean   @default(false) @map("is_blacklisted")
  blacklistReason String?   @map("blacklist_reason")
  
  children  Child[]
  visits    Visit[]
  orders    Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([phone], where: { deletedAt: null })
  @@map("clients")
}

model Child {
  id        Int       @id @default(autoincrement())
  name      String
  clientId  Int       @map("client_id")
  client    Client    @relation(fields: [clientId], references: [id])
  orders    Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("children")
}

model Costume {
  id            Int           @id @default(autoincrement())
  inventoryCode String        @unique @default(dbgenerated("generate_costume_code()")) @map("inventory_code")
  name          String
  notes         String?
  
  orders        Order[]

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  @@map("costumes")
}

model Visit {
  id              Int         @id @default(autoincrement())
  visitCode       String      @unique @map("visit_code")
  
  clientId        Int         @map("client_id")
  client          Client      @relation(fields: [clientId], references: [id])
  
  startDateTime   DateTime    @map("start_date_time")
  endDateTime     DateTime    @map("end_date_time")
  issueTimeFrom   String      @map("issue_time_from")
  issueTimeTo     String      @map("issue_time_to")
  returnTimeUntil String      @map("return_time_until")
  
  status          VisitStatus @default(reserved)
  version         Int         @default(1)
  notes           String?     @db.Text
  
  orders          Order[]
  notifications Notification[]
  deposits        Deposit[]
  moneyOperations VisitMoneyOperation[]
  auditEvents     AuditEvent[]

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  @@map("visits")
}

model AuditEvent {
  id                Int      @id @default(autoincrement())
  occurredAt        DateTime @default(now()) @map("occurred_at")
  actorUserId       Int?     @map("actor_user_id")
  actorUser         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorNameSnapshot String   @map("actor_name_snapshot")
  source            String
  action            String
  entityType        String   @map("entity_type")
  entityId          Int      @map("entity_id")
  visitId           Int?     @map("visit_id")
  visit             Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  orderId           Int?     @map("order_id")
  commandId         String   @map("command_id")
  schemaVersion     Int      @default(1) @map("schema_version")
  payload           Json

  @@index([visitId, occurredAt, id])
  @@index([occurredAt, id])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([orderId])
  @@map("audit_events")
}

model CommandReceipt {
  id            Int      @id @default(autoincrement())
  commandId     String   @unique @map("command_id")
  actorUserId   Int      @map("actor_user_id")
  actorUser     User     @relation(fields: [actorUserId], references: [id])
  commandPath   String   @map("command_path")
  requestHash   String   @map("request_hash")
  result        Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@map("command_receipts")
}

model VisitMoneyOperation {
  id             Int                     @id @default(autoincrement())
  visitId        Int                     @map("visit_id")
  visit          Visit                   @relation(fields: [visitId], references: [id])
  kind           VisitMoneyOperationKind
  amount         Int
  legacyImported Boolean                 @default(false) @map("legacy_imported")
  createdAt      DateTime                @default(now()) @map("created_at")
  voidedAt       DateTime?               @map("voided_at")

  @@index([visitId, voidedAt])
  @@map("visit_money_operations")
}

model Order {
  id               Int         @id @default(autoincrement())
  
  visitId          Int         @map("visit_id")
  visit            Visit       @relation(fields: [visitId], references: [id])
  
  clientId         Int         @map("client_id")
  client           Client      @relation(fields: [clientId], references: [id])
  
  childId          Int         @map("child_id")
  child            Child       @relation(fields: [childId], references: [id])
  
  costumeId        Int         @map("costume_id")
  costume          Costume     @relation(fields: [costumeId], references: [id])

  startDateTime    DateTime    @map("start_date_time")
  endDateTime      DateTime    @map("end_date_time")

  rentPrice        Int         @map("rent_price")
  prepaymentAmount Int         @default(0) @map("prepayment_amount")
  finalPayment     Int?        @map("final_payment")

  tagStatus        TagStatus   @default(not_written) @map("tag_status")
  status           OrderStatus @default(reserved)
  
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")

  @@map("orders")
}
model Deposit {
  id        Int         @id @default(autoincrement())
  visitId   Int         @map("visit_id")
  visit     Visit       @relation(fields: [visitId], references: [id])
  type      DepositType @default(none)
  returned  Boolean     @default(false)
  amount Int? @map("amount")

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  @@unique([visitId], map: "deposits_active_visit_id_key", where: raw("deleted_at IS NULL"))
  @@map("deposits")
}
model Notification {
  id          Int                @id @default(autoincrement())
  visitId     Int                @map("visit_id")
  visit       Visit              @relation(fields: [visitId], references: [id])
  
  traceId     String?
  externalId  String?            @unique @map("external_id")
  type        String             
  status      NotificationStatus @default(pending)
  errorText   String?            @map("error_text")
  
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("notifications")
}

enum NotificationStatus {
  pending   
  sent      
  delivered 
  read      
  failed    
  isConfirmed
  noAccount
}

enum DepositType {
  document
  cash
  none
}

enum VisitMoneyOperationKind {
  issue_payment
  debt_payment
  customer_refund
}


enum VisitStatus {
  reserved
  issued
  completed
  cancelled
}

enum OrderStatus {
  reserved
  issued
  returned
  cancelled
}

enum TagStatus {
  written
  not_written
  not_required
}
