# Шаблон apps/backend/.env.test для integration-тестов (`pnpm test:int`).
# Скопируй в .env.test. Файл не коммитится.
#
# ВАЖНО: БД — отдельная `costumes_test` (в том же dev-Postgres). Перед каждым прогоном
# она пересоздаётся (`prisma migrate reset --force`), поэтому имя БД ОБЯЗАНО заканчиваться
# на `_test` — иначе тесты и prepare-скрипт откажутся запускаться.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:123456@localhost:5432/costumes_test?schema=public

# Redis: тот же dev-redis, но отдельная логическая БД (db index). Перед тестами она очищается (FLUSHDB).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=15

JWT_SECRET=test-jwt-secret-not-for-production
CLIENT_URL=http://localhost:5173

# Green-API в integration-тестах заменён моком — реальные значения не нужны
GREEN_API_URL=http://green-api.invalid
GREEN_API_ID_INSTANCE=0
GREEN_API_TOKEN=test

# Тестовый сотрудник (создаётся в beforeAll): логин >= 6 символов, пароль >= 12
TEST_USER_LOGIN=test-user-login
TEST_USER_NAME=Тестовый Сотрудник
TEST_USER_PASSWORD=test-user-password-123
