# Шаблон корневого .env (читает прод docker-compose.yaml). Скопируй в .env и заполни.
# Значения ниже — плейсхолдеры, реальные секреты в git не коммитятся.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=costumes

# Внутри compose DATABASE_URL и REDIS_URL переопределяются на хосты postgres/redis
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/costumes?schema=public
REDIS_HOST=redis
REDIS_PORT=6379

PORT=5000
CLIENT_URL=https://example.com
SERVER_URL=https://example.com
SERVER_DOMAIN=example.com
JWT_SECRET=change-me-long-random-string

# WhatsApp (Green-API)
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Токен вебхука: тот же, что в настройке инстанса Green-API `webhookUrlToken`
# (Green-API шлёт `Authorization: Bearer <токен>`). В production без него вебхук отклоняется (401).
GREEN_API_WEBHOOK_TOKEN=
