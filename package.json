{
  "name": "costumes",
  "version": "1.0.0",
  "scripts": {
    "dev:shared": "pnpm --filter @costumes/shared exec tsc -b --watch",
    "dev:backend": "nest start backend --watch",
    "dev:frontend": "pnpm --filter crm-frontend dev",
    "start:dev": "concurrently \"pnpm dev:shared\" \"pnpm dev:backend\"",
    "build": "nest build backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "catalog:"
  },
  "private": true,
  "packageManager": "pnpm@10.18.3"
}
